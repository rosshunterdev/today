# Copy to .env.development.local (npm run dev) with your Supabase project's values.
# Without these, the app builds local-only: no cloud button, no network.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Copy to .env.test.local (npm run test:rls) and fill in from `supabase status` after `supabase start`. Local only.
# The secret key never goes in a VITE_ variable.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_SECRET_KEY=